# SkillGap Web Frontend Environment Configuration
# Copy this file to .env.local and adjust for production or local development.

# URL of the deployed FastAPI backend (default: http://127.0.0.1:8000)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Feature flag for upcoming AI resume builder workspace (default: false)
NEXT_PUBLIC_RESUME_BUILDER_ENABLED=false
