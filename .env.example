# SkillGap Backend Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Frontend origin allowed by CORS middleware (e.g. https://your-domain.vercel.app or http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# Maximum file upload size in megabytes (default: 5 MB)
MAX_UPLOAD_SIZE_MB=5

# Small Language Model (SLM) integration flag (default: false - 100% deterministic local pipeline)
USE_SLM=false

# Ollama local or remote daemon URL (only accessed if USE_SLM=true)
OLLAMA_BASE_URL=http://localhost:11434

# Primary and fallback Ollama SLM model tags
SLM_PRIMARY_MODEL=qwen2.5:3b-instruct
SLM_FALLBACK_MODEL=qwen2.5:1.5b-instruct

# Matching and extraction cosine similarity thresholds
SEM_MATCH_THRESHOLD=0.75
SEMANTIC_SIMILARITY_THRESHOLD=0.72
PARTIAL_THRESHOLD=0.80

# Weight blend for final match score (W_COVERAGE + W_SEMANTIC = 1.0)
W_COVERAGE=0.8
W_SEMANTIC=0.2

# Resume builder feature flag for Next.js frontend (default: true)
NEXT_PUBLIC_RESUME_BUILDER_ENABLED=true
